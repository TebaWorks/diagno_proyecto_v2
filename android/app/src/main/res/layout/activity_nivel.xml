<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/btnVolverNivel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Volver"
        android:padding="8dp"
        android:src="@drawable/ic_flecha_atras" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="¿Cuál es tu nivel\nde conocimiento?"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Esto nos permitirá darte respuestas\nmás adecuadas a tus necesidades."
        android:textColor="@color/texto_sec"
        android:textSize="15sp" />

    <!-- Novato -->
    <LinearLayout
        android:id="@+id/cardNovato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_nivel_seleccionado"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iconoNovato"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nivel_icono_activo"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_nivel_auto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novato"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estoy aprendiendo sobre autos"
                android:textColor="@color/texto_sec"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioNovato"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_radio_on" />
    </LinearLayout>

    <!-- Con conocimiento -->
    <LinearLayout
        android:id="@+id/cardConocimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nivel_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iconoConocimiento"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nivel_icono_inactivo"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_nivel_herramientas" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Con conocimiento"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tengo conocimientos básicos"
                android:textColor="@color/texto_sec"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioConocimiento"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_radio_off" />
    </LinearLayout>

    <!-- Avanzado -->
    <LinearLayout
        android:id="@+id/cardAvanzado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nivel_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iconoAvanzado"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nivel_icono_inactivo"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_nivel_engranaje" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avanzado"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tengo experiencia en mecánica"
                android:textColor="@color/texto_sec"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioAvanzado"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_radio_off" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnContinuarNivel"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_boton_azul"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Continuar"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>