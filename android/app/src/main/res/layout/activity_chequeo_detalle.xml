<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra superior: volver, título y paso (ej. 1/5) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnVolverDetalle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_flecha_atras" />

        <TextView
            android:id="@+id/tvTituloChequeo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPasoChequeo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_sec"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Barra de progreso -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoChequeo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:indicatorColor="@color/azul"
        app:trackColor="@color/azul_claro"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <!-- Lista de puntos a revisar -->
    <ScrollView
        android:id="@+id/scrollChequeo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listaPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_blanca"
            android:elevation="2dp"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnSiguienteChequeo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_boton_azul"
        android:text="Siguiente"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>