<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registroRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_flecha_atras"
            app:tint="@color/texto" />

        <!-- Progreso de los pasos -->
        <TextView
            android:id="@+id/tvPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Paso 1 de 2"
            android:textColor="@color/azul"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresoPasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progress="50"
            app:indicatorColor="@color/azul"
            app:trackColor="@color/borde"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tvTituloPaso"
            style="@style/Diagno.Titulo"
            android:layout_marginTop="24dp"
            android:text="Crea tu cuenta" />

        <TextView
            android:id="@+id/tvSubtituloPaso"
            style="@style/Diagno.Subtitulo"
            android:text="Tus datos para ingresar a Diagno" />

        <!-- ===== PASO 1: DATOS ===== -->
        <LinearLayout
            android:id="@+id/pasoDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Diagno.Campo"
                android:layout_marginTop="24dp"
                android:hint="Nombre">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Diagno.Campo"
                android:hint="Correo electrónico">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Diagno.Campo"
                android:hint="Contraseña"
                app:endIconMode="password_toggle"
                app:helperText="Mínimo 8 caracteres, con letras y números">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmar"
                style="@style/Diagno.Campo"
                android:hint="Confirmar contraseña"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ===== PASO 2: CONSENTIMIENTOS ===== -->
        <LinearLayout
            android:id="@+id/pasoConsentimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:padding="16dp"
                    android:text="Tus datos (cuenta, vehículos, consultas y fotos) se guardan solo para tu uso personal dentro de Diagno. No los vendemos ni los usamos para publicidad o estudios. Se almacenan en Brasil y tus consultas se procesan con servicios de Google."
                    android:textColor="@color/texto"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeerPolitica"
                style="@style/Diagno.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="Leer Términos y Política de privacidad" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPrivacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acepto los Términos de uso y la Política de privacidad (obligatorio)"
                android:textColor="@color/texto"
                app:buttonTint="@color/azul" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbMayorEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Declaro ser mayor de 18 años (obligatorio)"
                android:textColor="@color/texto"
                app:buttonTint="@color/azul" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbCompartir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quiero que las soluciones de mis consultas, sin datos personales, ayuden a otros usuarios (opcional)"
                android:textColor="@color/texto"
                app:buttonTint="@color/azul" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Puedes cambiar la opción de compartir cuando quieras desde tu Perfil."
                android:textColor="@color/texto_sec"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botón principal con indicador de carga -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                style="@style/Diagno.BotonPrincipal"
                android:text="Continuar" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@android:color/white"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta?"
                android:textColor="@color/texto_sec"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrLogin"
                style="@style/Diagno.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>