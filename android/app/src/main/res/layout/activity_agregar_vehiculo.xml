<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra superior -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:text="Agregar vehículo"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_blanca"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Auto / Moto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_toggle_fondo"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnAuto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_activo"
                    android:gravity="center"
                    android:text="Auto"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMoto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Moto"
                    android:textColor="@color/texto"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView style="@style/EtiquetaForm" android:text="Marca" />
            <Spinner
                android:id="@+id/spMarca"
                android:entries="@array/ph_marca"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input" />

            <TextView style="@style/EtiquetaForm" android:text="Modelo" />
            <Spinner
                android:id="@+id/spModelo"
                android:entries="@array/ph_modelo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input" />

            <TextView style="@style/EtiquetaForm" android:text="Año" />
            <Spinner
                android:id="@+id/spAnio"
                android:entries="@array/ph_anio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input" />

            <TextView style="@style/EtiquetaForm" android:text="Tipo de combustible" />
            <Spinner
                android:id="@+id/spCombustible"
                android:entries="@array/ph_combustible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input" />

            <TextView style="@style/EtiquetaForm" android:text="Kilometraje actual" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etKm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="0"
                    android:inputType="number"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textColor="@color/texto" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_boton_azul"
                android:gravity="center"
                android:text="Guardar vehículo"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>