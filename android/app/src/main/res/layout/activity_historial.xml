<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolverHistorial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Historial"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pestañas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_toggle_fondo"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabConsultas"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Consultas"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabChequeos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Chequeos"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Consultas -->
        <LinearLayout
            android:id="@+id/panelConsultas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/listaConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvVacioConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aún no tienes consultas. Aquí aparecerán las conversaciones que tengas con el asistente de IA."
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="Toca una consulta para verla. Mantén presionada para eliminarla."
                android:textColor="@color/texto_sec"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Chequeos (todavía sin datos) -->
        <LinearLayout
            android:id="@+id/panelChequeos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aún no tienes chequeos. Aquí aparecerán los chequeos guiados que realices."
                android:textColor="@color/texto_sec"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>