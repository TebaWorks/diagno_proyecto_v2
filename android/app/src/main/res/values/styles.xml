<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Foto de perfil redonda -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Tarjetas de funciones del inicio -->
    <style name="TarjetaHome" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">142dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>

        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/diagno_superficie</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/diagno_borde</item>

        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TarjetaContenido">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TarjetaTitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/diagno_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TarjetaSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/diagno_texto_sec</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Pantalla de perfil: se conserva por ahora -->
    <style name="TarjetaPerfil" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="FilaPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CampoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_sec</item>
        <item name="android:textSize">14sp</item>
        <item name="android:importantForAutofill" tools:ignore="NewApi">no</item>
    </style>

    <style name="EtiquetaForm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Pantalla de bienvenida -->
    <style name="ImagenRedondeada">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Estilo base -->
    <style name="Diagno" />

    <!-- Campo de texto de acceso -->
    <style name="Diagno.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/azul</item>
        <item name="hintTextColor">@color/azul</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <!-- Botón principal original: se conserva -->
    <style name="Diagno.BotonPrincipal" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/azul</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Nuevo botón principal naranja Diagno -->
    <style name="Diagno.BotonPrincipalNaranja" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/diagno_naranja</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Botón secundario para fondos oscuros -->
    <style name="Diagno.BotonSecundarioOscuro" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/diagno_texto</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/diagno_naranja</item>
    </style>

    <!-- Botón de texto original -->
    <style name="Diagno.BotonTexto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Títulos y subtítulos originales de acceso -->
    <style name="Diagno.Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Diagno.Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/texto_sec</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>